# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/purple-server?schema=public"

# Application Port & Environment
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# JWT Secrets (HMAC SHA-256)
JWT_ACCESS_SECRET="<generate-using-crypto-randomBytes-64-hex>"
JWT_REFRESH_SECRET="<generate-different-crypto-randomBytes-64-hex>"

# Redis (for BullMQ queues)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# SMTP Mailer
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@purple-bd.com"

# Initial SuperAdmin Credentials (Auto-bootstrapped if not in DB)
SUPER_ADMIN_EMAIL="superadmin@purple-bd.com"
SUPER_ADMIN_PASSWORD="SuperSecretPassword123!"
SUPER_ADMIN_NAME="System Super Admin"

